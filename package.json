{
  "name": "commerce-ops-control-center",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:agents": "npx tsx --tsconfig tsconfig.json scripts/test-agents.ts",
    "test:pipeline": "npx tsx --tsconfig tsconfig.json scripts/test-pipeline.ts",
    "test:observability": "npx tsx --tsconfig tsconfig.json scripts/test-observability.ts",
    "test:all": "npm run test:agents && npm run test:pipeline && npm run test:observability",
    "test:connections": "npx tsx scripts/test-connections.ts",
    "build:check": "npx tsc --noEmit",
    "health": "open http://localhost:3000/api/health",
    "mcp:test": "open http://localhost:3000/api/mcp-test",
    "check:env": "npx tsx scripts/check-env.ts",
    "setup:mcp": "claude mcp add loomi-mcp -- npx -y mcp-remote https://loomi-mcp-alpha.bloomreach.com/mcp"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "next": "15.0.0",
    "openai": "^4.0.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/ws": "^8.0.0",
    "autoprefixer": "^10.0.0",
    "dotenv": "^16.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
